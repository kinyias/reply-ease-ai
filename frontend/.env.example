# FastAPI Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Frontend App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# WebSocket URL
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Cookie Expiration in seconds
# Access Token cookie max age (86400s = 24 hours, matches backend ACCESS_TOKEN_EXPIRE_MINUTES)
NEXT_PUBLIC_ACCESS_TOKEN_COOKIE_MAX_AGE=86400

# Refresh Token cookie max age (604800s = 7 days, matches backend REFRESH_TOKEN_EXPIRE_DAYS)
NEXT_PUBLIC_REFRESH_TOKEN_COOKIE_MAX_AGE=604800
