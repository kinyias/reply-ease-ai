# Application Settings
PROJECT_NAME="Reply-Ease-AI API"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=True

# Server Host & Port
HOST="0.0.0.0"
PORT=8000

# Security & JWT
SECRET_KEY="replace-this-with-a-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection (PostgreSQL with asyncpg)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/reply_ease_ai"

# CORS Configuration (comma-separated list of origins)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Google Gemini & Pinecone Vector DB (RAG)
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-3.1-flash-lite"
GEMINI_FALLBACK_MODELS="gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-2.5-flash,gemini-3-flash,gemini-3.6-flash"
GEMINI_EMBEDDING_MODEL="gemini-embedding-001"
PINECONE_API_KEY="your-pinecone-api-key-here"
PINECONE_INDEX_NAME="reply-ease-ai"
PINECONE_ENVIRONMENT="us-east-1"

# SePay Payment Gateway
SEPAY_MERCHANT_ID="YOUR_MERCHANT_ID"
SEPAY_SECRET_KEY="YOUR_MERCHANT_SECRET_KEY"
SEPAY_WEBHOOK_API_KEY="YOUR_MERCHANT_SECRET_KEY"
SEPAY_API_URL="https://my.sepay.vn/userapi"

# SMTP Email Configuration (Gmail / Mailgun / Resend)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
SMTP_FROM_EMAIL="your-email@gmail.com"
SMTP_FROM_NAME="Reply Ease AI Support"

# App & Portal URLs
FRONTEND_URL="http://localhost:3000"
BACKEND_URL="http://localhost:8000"
STATIC_DIR="static"
