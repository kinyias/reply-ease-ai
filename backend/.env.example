# Application Settings
PROJECT_NAME="Reply-Ease-AI API"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=True

# Server Host & Port
HOST="0.0.0.0"
PORT=8000

# Security & JWT
SECRET_KEY="replace-this-with-a-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection (PostgreSQL with asyncpg)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/reply_ease_ai"

# CORS Configuration (comma-separated list of origins)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# OpenAI API Key
OPENAI_API_KEY="your-openai-api-key-here"
OPENAI_MODEL="gpt-3.5-turbo"

# SePay Payment Gateway
SEPAY_MERCHANT_ID="YOUR_MERCHANT_ID"
SEPAY_SECRET_KEY="YOUR_MERCHANT_SECRET_KEY"
SEPAY_WEBHOOK_API_KEY="YOUR_MERCHANT_SECRET_KEY"
SEPAY_API_URL="https://my.sepay.vn/userapi"

# SMTP Email Configuration (Gmail / Mailgun / Resend)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
SMTP_FROM_EMAIL="your-email@gmail.com"
SMTP_FROM_NAME="Reply Ease AI Support"

# App & Portal URLs
FRONTEND_URL="http://localhost:3000"
BACKEND_URL="http://localhost:8000"
STATIC_DIR="static"
