# Root gitignore for Reply-Ease-AI (FastAPI + Next.js)

# Python & Backend
backend/.venv/
backend/venv/
backend/ENV/
backend/__pycache__/
backend/*/__pycache__/
backend/*/*/__pycache__/
backend/*/*/*/__pycache__/
*.py[cod]
*$py.class
backend/.pytest_cache/
backend/alembic/versions/*.pyc
backend/static/uploads/*
!backend/static/uploads/.gitkeep

# Environment files
*.env
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local
!.env.example
!backend/.env.example
!frontend/.env.example

# Node.js & Frontend
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/.turbo/

# Logs & Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# OS & IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
